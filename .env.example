# =============================================================================
# loa-arcturus — acceptance harness environment (Sprint 4, Task 4.1)
# =============================================================================
# Copy to `.env` and edit. EVERY variable the harness reads is documented here
# (ROLE3-ORACLE-SPEC.md §10.2 / sdd.md §7.1). The DEFAULTS BELOW WORK AS-IS for
# the keyless mock run — `cp .env.example .env && docker compose up` boots,
# auto-migrates, and verifies with ZERO edits and ZERO secrets.
#
# A tester supplies AT MOST THREE values, and ONLY for the optional LIVE legs:
#   1. BEPOLIA_RPC_URL   — a public Bepolia RPC (live self-broadcast + Assertion C)
#   2. SEED_PRIVATE_KEY  — a throwaway, faucet-funded key (live self-broadcast)
#   3. DUNE_SIM_API_KEY  — optional, for real on-chain payer profiling (dune mode)
# None of these are 0xhoneyjar secrets. The mock path needs none of them.
# =============================================================================

# --- Provider mode -----------------------------------------------------------
# mock = keyless; runs the FULL filter logic against the deterministic synthetic
#        funding graph. Proves the METER (filter logic). CI uses this.
# rpc  = self-broadcast real Bepolia txs (needs BEPOLIA_RPC_URL + SEED_PRIVATE_KEY)
#        and profile payers via public RPC reads.
# dune = real on-chain payer profiling via Dune Sim (needs DUNE_SIM_API_KEY).
#        Proves REAL DATA.  (mock = filter logic; dune = real data.)
CHAIN_PROVIDER=mock

# --- Postgres (auto-provisioned by docker-compose; override if 5544 is taken) -
POSTGRES_USER=arcturus
POSTGRES_PASSWORD=arcturus
POSTGRES_DB=arcturus
PGPORT_HOST=5544
# DATABASE_URL is set automatically inside compose. For HOST runs (pnpm verify
# on your machine against the compose DB), uncomment:
# DATABASE_URL=postgres://arcturus:arcturus@localhost:5544/arcturus

# --- Redis (auto-provisioned by docker-compose; best-effort in settle()) ------
REDISPORT_HOST=6399
# For HOST runs against the compose Redis, uncomment:
# REDIS_URL=redis://localhost:6399

# --- Oracle tuning (optional; documented defaults live in src/oracle/config.ts)
# Affiliate allowlist (Filter 1, OPEN-3): comma-separated 0xhoneyjar/operator
# wallets, FLAGGED + excluded from the headline. Empty = built-in unmatchable
# placeholders (no real payer mis-flagged). The mock seed injects its own
# synthetic affiliate so anti-self-grading is demonstrable regardless.
AFFILIATE_ALLOWLIST=

# Dust floor in micro-USD (Filter 2, OPEN-4). Empty = $0.01 (10000 micro). 0 disables.
DUST_FLOOR_MICRO=

# --- LIVE legs only (leave BLANK for the keyless mock run) --------------------
# Public Bepolia RPC URL. Used by seed-bepolia.ts to self-broadcast real txs and
# read them back to confirm, and by verify.ts Assertion C explorer resolution.
# Public option (confirmed against the canonical chain registry, chainId 80069):
#   https://bepolia.rpc.berachain.com
BEPOLIA_RPC_URL=

# A THROWAWAY private key you funded from the Bepolia faucet
# (https://bepolia.faucet.berachain.com). NEVER use a key with real value.
# Used ONLY in CHAIN_PROVIDER=rpc to sign the tester's own self-broadcast txs,
# so the on-chain `from` == the real payer (the anti-sybil trust anchor).
SEED_PRIVATE_KEY=

# Optional Dune Sim API key for REAL payer profiling (CHAIN_PROVIDER=dune).
# Absent → the harness uses the keyless MockChainProvider; you are never blocked.
DUNE_SIM_API_KEY=
